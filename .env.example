# FixMyHostel Environment Configuration Example

# API Port & Environment
PORT=5000
NODE_ENV=production

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=fixmyhostel
DB_PASSWORD=hostel123
DB_NAME=fixmyhosteldb
MYSQL_ROOT_PASSWORD=root123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Auth Secret
JWT_SECRET=fixmyhostel-secret-key-2026

# Grafana Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

# Nagios Credentials
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASSWORD=nagios123
